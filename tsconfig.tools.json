{
  // The Node tools (tools/*.ts). Node ≥ 23 runs them directly by stripping the types, so this
  // config only type-checks (no output): only erasable syntax (no enums/namespaces/parameter
  // properties), and relative imports keep their .ts extension.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["tools/*.ts", "src/types.d.ts"]
}
